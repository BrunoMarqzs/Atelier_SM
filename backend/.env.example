APP_NAME="Atelier Sibele Marques API"
APP_ENV=development
API_PREFIX=/api
# Local:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/atelier_sibele
# Supabase direct connection example:
# DATABASE_URL=postgresql+asyncpg://postgres:SENHA_URL_ENCODED@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Supabase transaction pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepared_statement_cache_size=0
STAGING_DATABASE_URL=
PRODUCTION_DATABASE_URL=
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
SEED_ADMIN_NAME="Sibele Marques"
SEED_ADMIN_EMAIL=admin@ateliersibele.local
SEED_ADMIN_PASSWORD=change-me-admin-password
UPLOAD_PROVIDER=local
LOCAL_UPLOAD_DIR=storage/uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:8000/uploads
PUBLIC_WEB_BASE_URL=http://localhost:8084
MAX_UPLOAD_SIZE_BYTES=8388608
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
LOG_LEVEL=INFO
